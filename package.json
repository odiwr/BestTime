{
  "name": "besttime-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "A zoomable timeline that reads a Google Sheet. Monorepo root.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odiwr/BestTime.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "npm run dev --workspace @besttime/element"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
