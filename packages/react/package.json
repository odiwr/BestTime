{
  "name": "@besttime/react",
  "version": "0.1.0",
  "description": "React wrapper for the BestTime timeline element. Typed, and safe to render on a server.",
  "license": "MIT",
  "author": "odiwr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odiwr/BestTime.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/odiwr/BestTime#readme",
